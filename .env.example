# ===========================================================================
# MODELO DE CONFIGURAÇÃO
#
# Copie este arquivo para ".env" e preencha os valores reais.
#
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# O arquivo .env NUNCA vai para o GitHub — ele está no .gitignore.
# Este .env.example VAI, e serve para que outra pessoa (ou a banca)
# saiba quais variáveis o sistema precisa, sem nunca ver os valores.
# ===========================================================================

# Chave da API do Google Gemini.
# Obtida em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Chave usada pelo Flask para assinar os cookies de sessão.
# Precisa ser longa e aleatória. Para gerar uma, rode no terminal:
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
FLASK_SECRET_KEY=gere_uma_chave_aleatoria_aqui

# Limite diário de dietas geradas por usuário.
# Protege a cota gratuita da API durante o teste com voluntários.
LIMITE_DIETAS_POR_DIA=10
